  "suffixAmountPattern": "{AMT}\\s?{CUR}(?![A-Za-z])",
  "heuristicCounterpartyPattern": "\\b(?:from|to|at)\\s+(?<cp>[A-Z][A-Z0-9&'.\\- ]{2,40}?)(?=\\s*\\(|\\s+\\+?\\d{6,}|\\.(?:\\s|$)|,|$)"
}
