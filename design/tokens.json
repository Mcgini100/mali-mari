    "light": {
      "background": "#F3F5F2",
      "surface": "#FFFFFF",
      "surfaceRaised": "#FFFFFF",
      "surfaceSunken": "#E8ECE8",
      "separator": "#DCE2DD",
      "textPrimary": "#14211F",
      "textSecondary": "#5B6B67",
      "textTertiary": "#94A29E",
      "accent": "#11756B",
      "accentSoft": "#DDEFEA",
      "onAccent": "#FFFFFF",
      "warm": "#D9822B",
      "warmSoft": "#FBEBD7",
      "income": "#0E7C66",
      "incomeSoft": "#DCF0E9",
      "spend": "#B5483A",
      "spendSoft": "#F7E4DF",
      "warning": "#B7791F",
      "warningSoft": "#FAEFD9",
      "sky": "#E3EEEA",
      "bark": "#6E4E3A",
      "bud": "#B9C4B4",
      "haze": "#8FB59A"
    },
    "dark": {
      "background": "#0C1514",
      "surface": "#142120",
      "surfaceRaised": "#1B2B29",
      "surfaceSunken": "#0A1110",
      "separator": "#243433",
      "textPrimary": "#E9F1EE",
      "textSecondary": "#93A6A1",
      "textTertiary": "#5F716C",
      "accent": "#4FC3B0",
      "accentSoft": "#143A35",
      "onAccent": "#06201C",
      "warm": "#F0A54C",
      "warmSoft": "#3A2812",
      "income": "#57C9A0",
      "incomeSoft": "#12302A",
      "spend": "#F08A6E",
      "spendSoft": "#3A1D16",
      "warning": "#E9B44C",
      "warningSoft": "#33260F",
      "sky": "#112523",
      "bark": "#9A7760",
      "bud": "#3E504B",
      "haze": "#3F8F7E"
    }
  },
  "leaf": {
    "$note": "Msasa leaf tones for how a day went. Shared by both themes (illustration colours).",
    "light": "#5E9B57",
    "steady": "#A3A03C",
    "full": "#E0A13A",
    "heavy": "#C8652E",
    "gold": "#E9BE45"
  },
  "category": {
    "$note": "Soft tints that make lists lively without fighting the accent. [ink, tint] per theme.",
    "light": { "teal": ["#11756B", "#DDEFEA"], "amber": ["#B66A1C", "#FBEBD7"], "sage": ["#4E7A4A", "#E2EEDD"], "clay": ["#A4523B", "#F6E3DC"], "sky": ["#2F6F96", "#DEEBF3"], "plum": ["#7A4E78", "#EFE3EE"], "sand": ["#8A6D2F", "#F3EBD6"], "moss": ["#5D6B2A", "#ECEFD9"] },
    "dark": { "teal": ["#4FC3B0", "#143A35"], "amber": ["#F0A54C", "#3A2812"], "sage": ["#8CC183", "#1D3020"], "clay": ["#EE9A80", "#3A1F17"], "sky": ["#7DB9DE", "#14293A"], "plum": ["#CF9ACB", "#2E1C2D"], "sand": ["#DDBD72", "#332811"], "moss": ["#B4C46A", "#262C12"] }
  },
  "type": {
    "family": "System (SF Pro on iOS, Roboto on Android). Money always uses tabular figures.",
    "display": { "size": 44, "lineHeight": 48, "weight": 600, "tracking": -1.4 },
    "title1": { "size": 28, "lineHeight": 34, "weight": 600, "tracking": -0.6 },
    "title2": { "size": 22, "lineHeight": 28, "weight": 600, "tracking": -0.3 },
    "headline": { "size": 17, "lineHeight": 22, "weight": 600, "tracking": -0.2 },
    "body": { "size": 17, "lineHeight": 24, "weight": 400, "tracking": -0.2 },
    "callout": { "size": 15, "lineHeight": 20, "weight": 400, "tracking": -0.1 },
    "subhead": { "size": 15, "lineHeight": 20, "weight": 500, "tracking": -0.1 },
    "footnote": { "size": 13, "lineHeight": 18, "weight": 400, "tracking": 0 },
    "caption": { "size": 12, "lineHeight": 16, "weight": 600, "tracking": 0.4, "case": "uppercase" },
    "button": { "size": 17, "lineHeight": 22, "weight": 600, "tracking": -0.2 }
  },
  "space": { "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 24, "xl": 32, "xxl": 48, "xxxl": 64 },
  "spaceNote": "8pt grid. 4 and 12 are the only half-steps, used inside dense components. Screen gutters are 20.",
  "radius": { "control": 12, "card": 20, "sheet": 28, "pill": 999 },
  "motion": {
    "balanceRoll": { "durationMs": 520, "curve": "easeOutCubic" },
    "sheetRise": { "durationMs": 380, "curve": "cubic-bezier(0.2, 0.9, 0.25, 1)" },
    "currencySwap": { "durationMs": 260, "curve": "easeOutQuart" },
    "press": { "durationMs": 120, "scale": 0.97 },
    "treeSway": { "periodS": 11.4, "yawAmplitudeRad": 0.07, "note": "Wind turns the crown gently around the trunk." },
    "leafFlutter": { "periodS": 3.7, "amplitude": 0.015, "note": "Each leaf flutters on its own phase." },
    "leafGrow": { "durationMs": 600, "keys": [[0, 0], [0.35, 1.25], [0.6, 1]], "note": "A new day's leaf overshoots a little, then settles." }
  }
}
