{
  "$description": "Mari design tokens — single source of truth for the prototype (design/prototype.html) and the Flutter theme (lib/core/theme/tokens.dart). Change a value here, then mirror it there.",
  "color": {
    "light": {
      "background": "#F6F5F2",
      "surface": "#FFFFFF",
      "surfaceRaised": "#FFFFFF",
      "surfaceSunken": "#EEECE7",
      "separator": "#E4E1DB",
      "textPrimary": "#17161A",
      "textSecondary": "#6C6972",
      "textTertiary": "#A19DA6",
      "accent": "#6A4FD3",
      "accentSoft": "#EEEAFB",
      "onAccent": "#FFFFFF",
      "income": "#1E7F55",
      "incomeSoft": "#E3F2EA",
      "spend": "#B9502F",
      "spendSoft": "#F7E7E0",
      "warning": "#B87A0A",
      "warningSoft": "#FAF0D9"
    },
    "dark": {
      "background": "#0D0C0F",
      "surface": "#18171B",
      "surfaceRaised": "#211F25",
      "surfaceSunken": "#111013",
      "separator": "#2B292F",
      "textPrimary": "#F3F1F5",
      "textSecondary": "#9B97A2",
      "textTertiary": "#66626C",
      "accent": "#A592F2",
      "accentSoft": "#2A2440",
      "onAccent": "#16121F",
      "income": "#55C291",
      "incomeSoft": "#15281F",
      "spend": "#E68667",
      "spendSoft": "#2E1A14",
      "warning": "#E5B04E",
      "warningSoft": "#2C2210"
    }
  },
  "type": {
    "family": "System (SF Pro on iOS, Roboto on Android). Money always uses tabular figures.",
    "display": { "size": 44, "lineHeight": 48, "weight": 600, "tracking": -1.4 },
    "title1": { "size": 28, "lineHeight": 34, "weight": 600, "tracking": -0.6 },
    "title2": { "size": 22, "lineHeight": 28, "weight": 600, "tracking": -0.3 },
    "headline": { "size": 17, "lineHeight": 22, "weight": 600, "tracking": -0.2 },
    "body": { "size": 17, "lineHeight": 24, "weight": 400, "tracking": -0.2 },
    "callout": { "size": 15, "lineHeight": 20, "weight": 400, "tracking": -0.1 },
    "subhead": { "size": 15, "lineHeight": 20, "weight": 500, "tracking": -0.1 },
    "footnote": { "size": 13, "lineHeight": 18, "weight": 400, "tracking": 0 },
    "caption": { "size": 12, "lineHeight": 16, "weight": 600, "tracking": 0.4, "case": "uppercase" },
    "button": { "size": 17, "lineHeight": 22, "weight": 600, "tracking": -0.2 }
  },
  "space": { "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 24, "xl": 32, "xxl": 48, "xxxl": 64 },
  "spaceNote": "8pt grid. 4 and 12 are the only half-steps, used inside dense components (chip padding, icon-to-label gaps). Screen gutters are always 20 — the one deliberate exception, chosen so 16pt card padding + 20pt gutter lines card content up on a 36pt optical inset.",
  "radius": { "control": 12, "card": 18, "sheet": 28, "pill": 999 },
  "motion": {
    "balanceRoll": { "durationMs": 520, "curve": "easeOutCubic", "note": "Numbers count from old to new value; digits never jump because figures are tabular." },
    "sheetRise": { "durationMs": 380, "curve": "cubic-bezier(0.2, 0.9, 0.25, 1)", "note": "Content behind scales to 0.96 and dims, so the sheet reads as a layer above, not a replacement." },
    "currencySwap": { "durationMs": 260, "curve": "easeOutQuart", "note": "Old figure slides up 8px and fades, new one rises from 8px below." },
    "press": { "durationMs": 120, "scale": 0.97 }
  }
}
